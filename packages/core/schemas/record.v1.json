{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dot-prompts.dev/schemas/record/v1.json",
  "title": "Prompt Record",
  "description": "Provenance record for an LLM-driven code edit. Stores links and intent, not code content.",
  "type": "object",
  "required": ["version", "id", "timestamp", "model", "prompt", "targets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "link": {
      "$ref": "https://dot-prompts.dev/schemas/link/v1.json"
    },
    "target": {
      "type": "object",
      "required": ["path", "links"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  }
}
