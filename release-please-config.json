{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "plugins": [
    {
      "type": "node-workspace",
      "updateAllPackages": true
    }
  ],
  "packages": {
    "packages/core": {
      "component": "dot-prompts",
      "package-name": "dot-prompts",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/pi": {
      "component": "dot-prompts-pi",
      "package-name": "@dot-prompts/pi",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/conformance": {
      "component": "dot-prompts-conformance",
      "package-name": "@dot-prompts/conformance",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
