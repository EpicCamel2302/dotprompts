{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dot-prompts.dev/schemas/link/v1.json",
  "title": "Provenance Link",
  "description": "A typed link identifying where an edit applied within a target file. Path lives on the parent target; links must not include path.",
  "oneOf": [
    { "$ref": "#/$defs/fileLink" },
    { "$ref": "#/$defs/regionLink" },
    { "$ref": "#/$defs/gitLink" },
    { "$ref": "#/$defs/symbolLink" },
    { "$ref": "#/$defs/hashlineLink" }
  ],
  "$defs": {
    "fileLink": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "file" },
        "path": false
      },
      "additionalProperties": true
    },
    "regionLink": {
      "type": "object",
      "required": ["type", "startLine", "endLine"],
      "properties": {
        "type": { "const": "region" },
        "path": false,
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "gitLink": {
      "type": "object",
      "required": ["type", "commit"],
      "properties": {
        "type": { "const": "git" },
        "path": false,
        "commit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "symbolLink": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "symbol" },
        "path": false,
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hashlineLink": {
      "type": "object",
      "required": ["type", "line", "hash"],
      "properties": {
        "type": { "const": "hashline" },
        "path": false,
        "line": { "type": "integer", "minimum": 1 },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{2,4}$"
        }
      },
      "additionalProperties": true
    }
  }
}
